TAPESCALE_VERSION=0.2.0-alpha.4
TAPESCALE_HTTP_PORT=8080
TAPESCALE_DEMO_MODE=false
TAPESCALE_TAPE_MOTION_ENABLED=false
TAPESCALE_TAPE_PREPARATION_ENABLED=false
TAPESCALE_NATIVE_BACKUP_ENABLED=false
TAPESCALE_POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
TAPESCALE_WORKER_POLL_SECS=5
TAPESCALE_SCHEDULER_POLL_SECS=30
TAPESCALE_TAPE_DEVICES=
TAPESCALE_SYSFS_ROOT=/sys
TAPESCALE_MT_PATH=/usr/bin/mt-st
TAPESCALE_QUALIFICATION_TIMEOUT_SECS=1800
TAPESCALE_DATA_RUN_TIMEOUT_SECS=43200
TAPESCALE_TRANSFER_STALL_TIMEOUT_SECS=1800
TAPESCALE_DAR_PATH=/usr/local/bin/dar
TAPESCALE_NATIVE_SPOOL_RESERVE_BYTES=8589934592
TAPESCALE_NATIVE_SLICE_BYTES=68719476736
TAPESCALE_NATIVE_COMPRESSION_THREADS=4
TAPESCALE_SOURCE_HOST_PATH=./fixtures
TAPESCALE_RESTORE_HOST_PATH=./restore
RUST_LOG=tapescale=info,tower_http=info
