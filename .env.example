TAPESCALE_VERSION=0.1.0
TAPESCALE_HTTP_PORT=8080
TAPESCALE_DEMO_MODE=false
TAPESCALE_LAB_TAPE_MOTION_ENABLED=false
TAPESCALE_LAB_TAPE_QUALIFICATION_ENABLED=false
TAPESCALE_POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
TAPESCALE_WORKER_POLL_SECS=5
TAPESCALE_SCHEDULER_POLL_SECS=30
TAPESCALE_SITE_TIMEZONE=UTC
TAPESCALE_TAPE_DEVICES=
TAPESCALE_SYSFS_ROOT=/sys
TAPESCALE_MT_PATH=/usr/bin/mt-st
TAPESCALE_QUALIFICATION_TIMEOUT_SECS=1800
RUST_LOG=tapescale=info,tower_http=info
